# Db2 Ops Copilot — local environment template
# Copy to .env and fill in locally. NEVER commit the real .env file.
# Passwords are generated locally (e.g. via Python secrets) and entered only here.

# --- IBM Db2 Community Edition (docker container: db2server) ---
# Generated at instance setup; used for both instance owner and database users.
DB2_INSTANCE_PASSWORD=
# Dev database created in M1.4
DB2_DBNAME=testdb
# Read-only application account created in M1.4
DB2_RO_USER=db2ro
DB2_RO_PASSWORD=
# Connection target (port bound to 127.0.0.1 only — never expose publicly)
DB2_HOST=127.0.0.1
DB2_PORT=50000

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=granite4.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5
